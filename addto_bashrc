# Alias definitions.
# You may want to put all your additions into a separate file like
# ~/.bash_aliases, instead of adding them here directly.
# See /usr/share/doc/bash-doc/examples in the bash-doc package.

if [ -f ~/.bash_aliases ]; then
    . ~/.bash_aliases
fi

if [ -f ~/bash_alias_env.env ]; then
    . ~/bash_alias_env.env
    echo poop
fi


# enable programmable completion features (you don't need to enable
# this, if it's already enabled in /etc/bash.bashrc and /etc/profile
# sources /etc/bash.bashrc).
if ! shopt -oq posix; then
  if [ -f /usr/share/bash-completion/bash_completion ]; then
    . /usr/share/bash-completion/bash_completion
  elif [ -f /etc/bash_completion ]; then
    . /etc/bash_completion
  fi
fi
export PATH="$PATH:/opt/nvim-linux-x86_64/bin"
export FZF_DEFAULT_COMMAND='find . -type f' 
echo "----aliases-------"
. "$HOME/.cargo/env"

[ -f ~/.fzf.bash ] && source ~/.fzf.bash
export PATH="$HOME/.local/bin:$PATH"
grep  '#blocked$' /etc/hosts
grep '#doc' ~/.bash_aliases | awk -F'#doc' '{
  name = $1
  desc = $2
  gsub(/^[[:space:]]*alias[[:space:]]+/, "", name)
  gsub(/[=(].*$/, "", name)
  gsub(/^[[:space:]]+|[[:space:]]+$/, "", name)
  gsub(/^[[:space:]]+|[[:space:]]+$/, "", desc)
  printf "  \033[1;35m\033[0m \033[1;36m%-28s\033[0m \033[0;90m│\033[0m \033[1;33m\033[0m %s\n", name, desc
}'
