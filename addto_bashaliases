f_py_create_repo() { #doc new py repo w readme and .gitignore
  local repo_name="$1"
  
  if gh repo view "XXXXXgithub_userXXXX/$repo_name" &>/dev/null; then
    echo "Error: Repo $repo_name already exists on GitHub"
    return 1
  fi
  
  mkdir "$repo_name" && cd "$repo_name" || return 1
  
  git init
  gh repo create "$repo_name" --private --source=. --remote=origin
  
  curl -o .gitignore https://raw.githubusercontent.com/github/gitignore/main/Python.gitignore
  
  echo "# $repo_name" > README.md
  nvim README.md
  
  git add .
  git commit -m "first commit"
  git branch -M main  # Rename to main before push
  git push -u origin main
}
f_acp() { #doc pip frz add commit push
    # Check if .git exists
    if [ ! -d ".git" ]; then
        echo "Error: Not in a git repository"
        return 1
    fi
    
    # Use "f_acp: no args" if no arguments are provided
    local commit_message="${@:-f_acp: no args}"

    pip freeze > requests.txt && git add . && git commit -m "$commit_message" && git push
}
t_check_nrun_venv(){ #doc tmux: activate if venv
